DATABASE_URL=mysql+pymysql://root:root@localhost:3306/sales_billing
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Client secret used for the On-Behalf-Of flow to call Microsoft Graph / SharePoint
AZURE_CLIENT_SECRET=
JWT_AUDIENCE=
# SharePoint site to test, on behalf of the signed-in user
SHAREPOINT_HOSTNAME=
SHAREPOINT_SITE_PATH=

# Database Connection — when MYSQL_HOST is set these take precedence over
# DATABASE_URL. MYSQL_SSL is the path to a CA cert (PEM); leave it blank for a
# non-TLS connection.
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=sales_billing
MYSQL_SSL=certs/
# Copy to .env and fill in. Vite exposes only vars prefixed with VITE_.
# These are PUBLIC values (safe to ship in a frontend bundle).

# Application (client) ID from your app registration Overview page
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Directory (tenant) ID from the same page
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# The API scope you exposed under "Expose an API".
# Normally api://<client-id>/access_as_user
VITE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# FastAPI backend base URL used by src/services/api.ts
VITE_API_BASE_URL=http://localhost:8000
